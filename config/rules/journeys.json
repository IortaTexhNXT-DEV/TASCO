    "crossSell": {
      "id": "cross_sell",
      "name": "Cover upgrade after purchase",
      "objective": "cross_sell",
      "steps": [
        {
          "offset": 1,
          "step": "cross_sell",
          "channels": [
            "app_push",
            "zalo_zns"
          ],
          "marketing": true,
          "template": "cross_sell"
