{
  "kind": "journeys",
  "description": "Journey engine: each journey has an audience (JSON Logic over lead facts), an anchor date and timed steps. Covers retention AND new business. A vehicle is placed in the FIRST matching journey (priority order). Steps stop as soon as the vehicle is insured with TASCO. Company-owned vehicles are excluded (routed to the fleet/B2B team by the nba rule set).",
  "payload": {
    "catchUpDays": 2,
    "journeys": [
      {
        "id": "lapsed_uninsured",
        "name": "Uninsured vehicle recovery",
        "objective": "new_business",
        "priority": 1,
        "audience": {
          "and": [
            {
              "!=": [
                {
                  "var": "ownerType"
                },
                "company"
              ]
            },
            {
              "and": [
                {
                  "!=": [
                    {
                      "var": "days"
                    },
                    null
                  ]
                },
                {
                  "<": [
                    {
                      "var": "days"
                    },
                    0
                  ]
                },
                {
                  ">=": [
                    {
                      "var": "days"
                    },
                    -60
                  ]
                },
                {
                  ">=": [
                    {
                      "var": "expiryConfidence"
                    },
                    0.5
                  ]
                }
              ]
            }
          ]
        },
        "anchor": "today",
        "steps": [
          {
            "offset": 0,
            "step": "lapsed_notice",
            "channels": [
              "app_push",
              "zalo_zns",
              "sms"
            ],
            "marketing": false,
            "template": "lapsed_notice"
          },
          {
            "offset": 2,
            "step": "voice_bot",
            "channels": [
              "voice_bot"
            ],
            "marketing": true,
            "onlyTiers": [
              "hot",
              "warm"
            ]
          },
          {
            "offset": 5,
            "step": "telesales",
            "channels": [
              "telesales"
            ],
            "marketing": true,
            "onlyTiers": [
              "hot"
            ]
          }
        ]
      },
      {
        "id": "new_vehicle",
        "name": "New vehicle onboarding",
        "objective": "new_business",
        "priority": 2,
        "audience": {
          "and": [
            {
              "!=": [
                {
                  "var": "ownerType"
                },
                "company"
              ]
            },
            {
              "and": [
                {
                  "!=": [
                    {
                      "var": "tagAgeDays"
                    },
                    null
                  ]
                },
                {
                  "<=": [
                    {
                      "var": "tagAgeDays"
                    },
                    60
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "insurer"
                    },
                    "TASCO"
                  ]
                }
              ]
            }
          ]
        },
        "anchor": "tagActivatedAt",
        "steps": [
          {
            "offset": 1,
            "step": "welcome",
            "channels": [
              "app_push",
              "zalo_zns"
            ],
            "marketing": false,
            "template": "new_vehicle_welcome"
          },
          {
            "offset": 7,
            "step": "verify_expiry",
            "channels": [
              "app_push",
              "zalo_zns"
            ],
            "marketing": false,
            "template": "verify_expiry"
          },
          {
            "offset": 14,
            "step": "value_reminder",
            "channels": [
              "app_push",
              "zalo_zns"
            ],
            "marketing": true,
            "template": "value_reminder"
          }
        ]
      },
      {
        "id": "renewal",
        "name": "TASCO renewal (retention)",
        "objective": "retention",
        "priority": 3,
        "audience": {
          "and": [
            {
              "!=": [
                {
                  "var": "ownerType"
                },
                "company"
              ]
            },
            {
              "==": [
                {
                  "var": "insurer"
                },
                "TASCO"
              ]
            }
          ]
        },
        "anchor": "expiry",
