            "channels": [
              "app_push",
              "zalo_zns",
              "sms"
            ],
            "marketing": true,
            "template": "first_reminder"
          },
          {
            "offset": -21,
            "step": "value_reminder",
            "channels": [
              "zalo_zns",
              "app_push"
            ],
            "marketing": true,
            "template": "value_reminder"
          },
          {
            "offset": -14,
            "step": "voice_bot",
            "channels": [
              "voice_bot"
            ],
            "marketing": true,
            "onlyTiers": [
              "hot",
              "warm"
            ]
          },
          {
            "offset": -7,
            "step": "urgent_reminder",
            "channels": [
              "app_push",
              "zalo_zns",
              "sms"
            ],
            "marketing": true,
            "template": "urgent_reminder"
          },
          {
            "offset": -3,
            "step": "telesales",
            "channels": [
              "telesales"
            ],
            "marketing": true,
            "onlyTiers": [
              "hot"
            ]
          },
          {
            "offset": 0,
            "step": "expiry_day",
            "channels": [
              "app_push",
              "zalo_zns",
              "sms"
            ],
            "marketing": false,
            "template": "expiry_day"
          }
        ]
      },
      {
        "id": "conquest",
        "name": "Conquest (insured elsewhere or unknown insurer)",
        "objective": "new_business",
        "priority": 4,
        "audience": {
          "and": [
            {
              "!=": [
                {
                  "var": "ownerType"
                },
                "company"
              ]
            },
            {
              "!=": [
                {
                  "var": "insurer"
                },
                "TASCO"
              ]
            }
          ]
        },
        "anchor": "expiry",
        "steps": [
          {
            "offset": -45,
            "step": "verify_expiry",
            "channels": [
              "app_push",
              "zalo_zns"
            ],
            "marketing": false,
            "template": "verify_expiry"
          },
          {
            "offset": -30,
            "step": "first_reminder",
            "channels": [
              "app_push",
              "zalo_zns",
              "sms"
            ],
            "marketing": true,
            "template": "conquest_reminder"
          },
          {
            "offset": -21,
            "step": "value_reminder",
            "channels": [
              "zalo_zns",
              "app_push"
            ],
            "marketing": true,
            "template": "value_reminder"
          },
          {
            "offset": -14,
            "step": "voice_bot",
            "channels": [
              "voice_bot"
            ],
            "marketing": true,
            "onlyTiers": [
