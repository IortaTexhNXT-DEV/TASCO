{
  "kind": "abac",
  "description": "Attribute-based access rules evaluated after RBAC. Facts: user.{id,roles,region}, resource.{type,region,assignedTo,ownerId}, action. A policy is skipped only when the user also holds an out-of-scope role that grants the policy's permission on its own.",
  "payload": {
    "policies": [
      {
        "id": "agent_own_handoffs",
        "resource": "handoff",
        "actions": [
          "read",
          "update"
        ],
        "appliesToRoles": [
          "telesales_agent"
        ],
        "allow": {
          "and": [
            {
              "or": [
                {
                  "==": [
                    {
                      "var": "resource.assignedTo"
                    },
                    {
                      "var": "user.id"
                    }
                  ]
                },
                {
                  "==": [
                    {
                      "var": "resource.assignedTo"
                    },
                    null
                  ]
                }
              ]
            },
            {
              "or": [
                {
                  "==": [
                    {
                      "var": "user.region"
                    },
                    "ALL"
                  ]
                },
                {
                  "==": [
                    {
                      "var": "user.region"
                    },
                    {
                      "var": "resource.region"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "permission": "handoff:read"
      },
      {
        "id": "regional_data",
        "resource": "profile",
        "actions": [
          "read",
          "update"
        ],
        "appliesToRoles": [
          "telesales_agent",
          "telesales_supervisor",
          "data_steward"
        ],
        "allow": {
          "or": [
            {
              "==": [
                {
                  "var": "user.region"
                },
                "ALL"
              ]
            },
            {
              "==": [
                {
                  "var": "user.region"
                },
                {
                  "var": "resource.region"
                }
              ]
            }
          ]
        },
        "permission": "profile:read"
      },
      {
        "id": "customer_self",
        "resource": "customer_self",
        "actions": [
          "read",
          "purchase"
        ],
        "appliesToRoles": [
          "customer"
        ],
        "allow": {
          "==": [
            {
              "var": "resource.ownerId"
            },
            {
              "var": "user.customerId"
            }
          ]
        },
        "permission": "customer:self"
      }
    ]
  }
}