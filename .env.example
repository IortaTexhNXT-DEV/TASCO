# Copy to .env for local runs. Never commit real secrets. Every *_SECRET/*_KEY
# variable can instead be provided as a file via <NAME>_FILE (Docker/K8s secrets).
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Persistence: omit DATABASE_URL to use the in-memory store (demo/tests only)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasco
DATABASE_SSL=false
DB_POOL_MAX=10
MIGRATE_ON_START=true

# Secrets (REQUIRED in production) — generate with: openssl rand -base64 32
JWT_SECRET=
JWT_TTL_SECONDS=1800
DATA_KEYS=k1:<base64-32-bytes>          # comma-separated keyId:key; add a new id to rotate
DATA_KEY_ACTIVE=k1
BLIND_INDEX_KEY=
METRICS_TOKEN=                           # optional bearer token for /metrics

# Security
CORS_ORIGINS=                            # comma-separated extra origins (same-origin always allowed)
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
LOCKOUT_MAX_FAILURES=5
LOCKOUT_MINUTES=15
MFA_REQUIRED_ROLES=admin,rule_approver,compliance_officer,data_steward
LINK_TTL_DAYS=30
BODY_LIMIT_BYTES=1048576

# Rating & products — TASCO core (policy administration) is the system of record
#   rules              local rule sets (default; sandbox/demo — refused in production unless ALLOW_LOCAL_RATING=true)
#   core               TASCO core prices every quote; 503 (fail closed) while core is unavailable
#   core_with_fallback core first; if core is unavailable, an *indicative* local price that cannot be paid until re-rated by core
RATING_SOURCE=rules
ALLOW_LOCAL_RATING=false                 # production escape hatch for RATING_SOURCE=rules / the simulated core
TASCO_CORE_BASE_URL=                     # e.g. https://core-api.tascoinsurance.com.vn — empty = simulated core (sandbox/UAT)
TASCO_CORE_TOKEN_URL=                    # optional; default <TASCO_CORE_BASE_URL>/oauth2/token
TASCO_CORE_CLIENT_ID=
TASCO_CORE_CLIENT_SECRET=                # or TASCO_CORE_CLIENT_SECRET_FILE
TASCO_CORE_SCOPE=rating:quote products:read
TASCO_CORE_TIMEOUT_MS=5000               # per HTTP call; retries + circuit breaker on top
# mTLS to core: terminate at the egress proxy / mesh, or pass an undici Agent as `dispatcher`
# to createTascoCoreRatingClient (see src/adapters/integrations/tascoCoreRatingClient.js).

# Demo / UAT only — never in production
DEMO_MODE=false
SEED_RECORDS=2500
SIM_TODAY=
